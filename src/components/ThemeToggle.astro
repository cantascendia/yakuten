---
/**
 * ThemeToggle — 同页切换 html.sakura class
 *
 * 不跳转路由。点击 = 当前页用 sakura 视觉重绘。
 * Starlight 的侧栏/搜索/TOC/面包屑/分页全部保留。
 * 偏好存 localStorage，跨页保持。
 *
 * 配套：SakuraHint 首次访问引导卡片（同 layout 渲染）。
 *  · ThemeToggle 监听 `sakura-hint:activate` 自定义事件 → 切到 sakura
 *  · ThemeToggle 切换时派发 `sakura-theme:change` 让 hint 等组件感知
 */
---

<style is:global>
  /* 屏幕阅读器专用描述：visually hidden 但仍参与 a11y 树 */
  .sakura-toggle-sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  #sakura-toggle {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 9999;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 13px;
    font-weight: 700;
    /* 纯白文字，在所有深色/粉色背景上都够对比度 */
    color: #FFFFFF;
    /* 实心樱粉渐变，不再透明毛玻璃 */
    background: linear-gradient(135deg, #C84B7C 0%, #E5578B 100%);
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    cursor: pointer;
    transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 3px 12px rgba(200, 75, 124, 0.45);
  }
  #sakura-toggle:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
    box-shadow: 0 6px 18px rgba(200, 75, 124, 0.6);
  }
  #sakura-toggle:active { transform: translateY(0); }
  #sakura-toggle:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
    box-shadow: 0 0 0 4px rgba(200, 75, 124, 0.5);
  }

  #sakura-toggle .sakura-toggle__icon {
    font-size: 14px;
    line-height: 1;
    transition: transform 0.3s ease;
  }
  #sakura-toggle:hover .sakura-toggle__icon {
    transform: rotate(20deg) scale(1.1);
  }

  /* 副标签：默认隐藏，hover/focus 时滑入显示，提示「这是切换主题」 */
  #sakura-toggle .sakura-toggle__hint {
    max-width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: max-width 0.25s ease, opacity 0.2s ease, margin-left 0.25s ease;
    margin-left: 0;
  }
  #sakura-toggle:hover .sakura-toggle__hint,
  #sakura-toggle:focus-visible .sakura-toggle__hint {
    max-width: 120px;
    opacity: 0.95;
    margin-left: 4px;
  }

  /* 当 sakura 已开启：按钮变糖果胶囊 */
  html.sakura #sakura-toggle {
    background: #FFFAF0;
    color: #4A2838;
    border: 2px solid #4A2838;
    box-shadow: 3px 3px 0 #4A2838;
  }
  html.sakura #sakura-toggle:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 #4A2838;
    background: #FFE4EC;
  }
  html.sakura #sakura-toggle .sakura-toggle__label::after {
    content: " ✓";
    color: #E5578B;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    #sakura-toggle {
      bottom: 16px; left: 16px;
      padding: 6px 12px; font-size: 12px;
    }
    /* 移动端不显示副标签节省空间 */
    #sakura-toggle .sakura-toggle__hint { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #sakura-toggle,
    #sakura-toggle .sakura-toggle__icon,
    #sakura-toggle .sakura-toggle__hint { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var KEY = "sakura-theme";
    var root = document.documentElement;

    // 进入页面立刻应用偏好（避免闪烁）
    try {
      if (localStorage.getItem(KEY) === "on") {
        root.classList.add("sakura");
      }
    } catch (e) {}

    // 文案：按页面语言（html[lang]）本地化，再按当前模式切换。
    // is:inline 脚本无法 import，故内嵌 zh/ja/en/ko 文案表；其余语种回退 en。
    var I18N = {
      zh: {
        label: "新版",
        off: {
          ariaLabel: "切换到樱花手账主题（浅色 · 优化血检手账界面）",
          title: "切换乐园手账主题（樱粉浅色风格 · 优化血检手账界面） — 不会跳转路由，侧栏/搜索/TOC 全部保留",
          srDesc: "点击切换到樱花手账浅色主题，配色更柔和，并启用 v3.2 血检手账记录界面。皮肤偏好保存在你的浏览器，不会上传。",
          hint: "切换主题"
        },
        on: {
          ariaLabel: "切回二相乐园主题（深色 · 米哈游风格）",
          title: "切回二相乐园主题（深色）— 当前为樱花手账浅色模式",
          srDesc: "当前为樱花手账浅色主题。点击切回米哈游二相乐园深色主题。皮肤偏好保存在你的浏览器，不会上传。",
          hint: "切回深色"
        }
      },
      ja: {
        label: "新スキン",
        off: {
          ariaLabel: "桜手帳テーマ（ライト · 血液検査手帳UI）に切り替える",
          title: "桜手帳テーマに切り替え（桜色のライトスタイル · 血液検査手帳UI） — ページ遷移なし、サイドバー/検索/目次はすべて保持",
          srDesc: "クリックで桜手帳ライトテーマに切り替えます。配色がより柔らかくなり、v3.2 血液検査手帳の記録UIが有効になります。スキン設定はお使いのブラウザに保存され、アップロードされません。",
          hint: "テーマ切替"
        },
        on: {
          ariaLabel: "二相のパライソテーマ（ダーク · miHoYo風）に戻す",
          title: "二相のパライソテーマ（ダーク）に戻す — 現在は桜手帳ライトモードです",
          srDesc: "現在は桜手帳ライトテーマです。クリックで miHoYo「二相のパライソ」ダークテーマに戻します。スキン設定はお使いのブラウザに保存され、アップロードされません。",
          hint: "ダークに戻す"
        }
      },
      en: {
        label: "New skin",
        off: {
          ariaLabel: "Switch to the Sakura Journal theme (light · blood-test journal UI)",
          title: "Switch to the Sakura Journal theme (soft-pink light style · blood-test journal UI) — no page reload; sidebar, search and TOC are all preserved",
          srDesc: "Click to switch to the Sakura Journal light theme. Colors become softer and the v3.2 blood-test journal UI is enabled. Your skin preference is stored in your browser and never uploaded.",
          hint: "Switch theme"
        },
        on: {
          ariaLabel: "Switch back to the Dual-Paradise theme (dark · miHoYo style)",
          title: "Switch back to the Dual-Paradise theme (dark) — currently in Sakura Journal light mode",
          srDesc: "You are in the Sakura Journal light theme. Click to switch back to the miHoYo Dual-Paradise dark theme. Your skin preference is stored in your browser and never uploaded.",
          hint: "Back to dark"
        }
      },
      ko: {
        label: "새 스킨",
        off: {
          ariaLabel: "사쿠라 수첩 테마(라이트 · 혈액검사 수첩 UI)로 전환",
          title: "사쿠라 수첩 테마로 전환(부드러운 핑크 라이트 · 혈액검사 수첩 UI) — 페이지 이동 없음, 사이드바/검색/목차 모두 유지",
          srDesc: "클릭하면 사쿠라 수첩 라이트 테마로 전환됩니다. 색감이 부드러워지고 v3.2 혈액검사 수첩 기록 UI가 활성화됩니다. 스킨 설정은 브라우저에 저장되며 업로드되지 않습니다.",
          hint: "테마 전환"
        },
        on: {
          ariaLabel: "이상낙원 테마(다크 · miHoYo 스타일)로 되돌리기",
          title: "이상낙원 테마(다크)로 되돌리기 — 현재 사쿠라 수첩 라이트 모드",
          srDesc: "현재 사쿠라 수첩 라이트 테마입니다. 클릭하면 miHoYo 이상낙원 다크 테마로 되돌립니다. 스킨 설정은 브라우저에 저장되며 업로드되지 않습니다.",
          hint: "다크로"
        }
      }
    };
    var DOC_LANG = (document.documentElement.lang || "zh").toLowerCase();
    var LANG = DOC_LANG.indexOf("ja") === 0 ? "ja"
      : DOC_LANG.indexOf("ko") === 0 ? "ko"
      : DOC_LANG.indexOf("zh") === 0 ? "zh"
      : "en";
    var STR = I18N[LANG] || I18N.en;

    // 文案：根据当前模式动态切换（已按页面语言本地化）
    function copyFor(on) {
      // on = 当前是否已是 sakura
      return on ? STR.on : STR.off;
    }

    function syncCopy(btn) {
      var on = root.classList.contains("sakura");
      var c = copyFor(on);
      btn.setAttribute("aria-label", c.ariaLabel);
      btn.setAttribute("title", c.title);
      btn.setAttribute("aria-pressed", on ? "true" : "false");
      var sr = btn.querySelector("#sakura-toggle-desc");
      if (sr) sr.textContent = c.srDesc;
      var hint = btn.querySelector(".sakura-toggle__hint");
      if (hint) hint.textContent = c.hint;
    }

    function setSakura(on) {
      if (on) {
        root.classList.add("sakura");
        try { localStorage.setItem(KEY, "on"); } catch (e) {}
      } else {
        root.classList.remove("sakura");
        try { localStorage.setItem(KEY, "off"); } catch (e) {}
      }
      var btn = document.getElementById("sakura-toggle");
      if (btn) syncCopy(btn);
      // 派发事件，让 SakuraHint 等组件感知
      try {
        document.dispatchEvent(new CustomEvent("sakura-theme:change", { detail: { on: on } }));
      } catch (e) {}
    }

    function mount() {
      if (document.getElementById("sakura-toggle")) return;
      var btn = document.createElement("button");
      btn.id = "sakura-toggle";
      btn.type = "button";
      btn.setAttribute("aria-describedby", "sakura-toggle-desc");
      btn.innerHTML =
        '<span class="sakura-toggle__icon" aria-hidden="true">🌸</span>' +
        '<span class="sakura-toggle__label"></span>' +
        '<span class="sakura-toggle__hint" aria-hidden="true"></span>' +
        '<span id="sakura-toggle-desc" class="sakura-toggle-sr-only"></span>';
      var labelEl = btn.querySelector(".sakura-toggle__label");
      if (labelEl) labelEl.textContent = STR.label;
      syncCopy(btn);
      btn.addEventListener("click", function () {
        var on = root.classList.contains("sakura");
        setSakura(!on);
      });
      document.body.appendChild(btn);

      // 监听来自 SakuraHint 的「体验」事件
      document.addEventListener("sakura-hint:activate", function () {
        setSakura(true);
      });
    }

    if (document.body) mount();
    else document.addEventListener("DOMContentLoaded", mount);
  })();
</script>
