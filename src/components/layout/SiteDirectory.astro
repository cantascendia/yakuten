const UI: Record<Lang, { title: string; note: string }> = {
  zh: { title: '目录', note: '全站主要板块，从这里到达' },
  en: { title: 'Directory', note: 'All main sections of the site' },
  ja: { title: '目次', note: 'サイトの主要セクションへ' },
  ko: { title: '목차', note: '사이트 주요 섹션 바로가기' },
  es: { title: 'Índice', note: 'Secciones principales del sitio' },
  pt: { title: 'Índice', note: 'Seções principais do site' },
  fr: { title: 'Sommaire', note: 'Les sections principales du site' },
  de: { title: 'Übersicht', note: 'Die Hauptbereiche der Website' },
  ru: { title: 'Разделы', note: 'Основные разделы сайта' },
  ar: { title: 'الفهرس', note: 'الأقسام الرئيسية للموقع' },
  fa: { title: 'فهرست', note: 'بخش‌های اصلی سایت' },
  th: { title: 'สารบัญ', note: 'ส่วนหลักของเว็บไซต์' },
  vi: { title: 'Mục lục', note: 'Các mục chính của trang' },
  id: { title: 'Daftar Isi', note: 'Bagian utama situs' },
  fil: { title: 'Talaan', note: 'Mga pangunahing seksyon ng site' },
  hi: { title: 'सूची', note: 'साइट के मुख्य खंड' },
  tr: { title: 'Dizin', note: 'Sitenin ana bölümleri' },
};

const PATHS = ['before-you-start/', 'pathway/', 'medications/estrogens/overview/', 'blood-tests/', 'guides/', 'risks/'];

const locale = Astro.currentLocale ?? 'zh';
const names = NAMES[locale] ?? NAMES.zh;
const metas = METAS[locale] ?? METAS.zh;
const ui = UI[locale] ?? UI.zh;

const entries: DirectoryEntry[] = PATHS.map((path, i) => ({
  num: String(i + 1).padStart(2, '0'),
  name: names[i],
  path: '/' + locale + '/' + path,
  meta: metas[i],
}));
---

<section class="site-dir">
  <div class="site-dir__card glass-panel clipped-card">
    <div class="site-dir__head">
      <h2 class="site-dir__title">{ui.title}</h2>
      <p class="site-dir__note">{ui.note}</p>
    </div>
    <nav class="site-dir__nav" aria-label={ui.title}>
      {entries.map((entry) => (
        <a href={entry.path} class="site-dir__row">
          <span class="site-dir__num" aria-hidden="true">{entry.num}</span>
          <span class="site-dir__name">{entry.name}</span>
          <span class="site-dir__leader" aria-hidden="true"></span>
          <span class="site-dir__meta">{entry.meta}</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<style>
  .site-dir {
    position: relative;
    z-index: 10;
    padding: 0 var(--space-lg) var(--space-xl);
    max-width: 80rem;
    margin: 0 auto;
  }

  /* 卡片版心对齐 /zh/v2 目录卡（760px）：点线 leader 行在窄版心里才有书目感 */
  .site-dir__card {
    max-width: 47.5rem;
    margin-inline: auto;
    padding: var(--space-lg) var(--space-xl);
  }

  @media (max-width: 640px) {
    .site-dir__card {
      padding: var(--space-lg);
    }
  }

  .site-dir__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-block: 0 var(--space-sm);
  }

  .site-dir__title,
  :global(.sl-markdown-content) .site-dir__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .site-dir__note,
  :global(.sl-markdown-content) .site-dir__note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .site-dir__nav,
  :global(.sl-markdown-content) .site-dir__nav {
    display: flex;
    flex-direction: column;
    margin-block-start: 0;
  }

  /* 行 = 整行可点链接。颜色变化瞬时切换（动效白名单外不过渡），无位移动效。 */
  .site-dir__row,
  :global(.sl-markdown-content) .site-dir__row {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: 10px;
    text-decoration: none;
    color: inherit;
  }
  .site-dir__row:hover,
  :global(.sl-markdown-content) .site-dir__row:hover {
    text-decoration: none;
  }

  .site-dir__num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .site-dir__name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .site-dir__row:hover .site-dir__name,
  .site-dir__row:focus-visible .site-dir__name {
    color: var(--color-primary-light);
  }

  .site-dir__leader {
    flex: 1;
    min-width: 24px;
    border-block-end: 2px dotted var(--color-outline-25);
    transform: translateY(-4px);
  }

  /* 说明列允许换行（375px 屏「雌激素 · 抗雄 · 孕激素」一行放不下）；
     RTL 逻辑属性对齐行尾侧。 */
  .site-dir__meta {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: end;
    max-width: 45%;
  }

  @media (max-width: 640px) {
    .site-dir__row,
    :global(.sl-markdown-content) .site-dir__row {
      gap: var(--space-sm);
    }
    .site-dir__meta {
      font-size: 0.75rem;
    }
  }
</style>
