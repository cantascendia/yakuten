---
/**
 * HospitalCard — 友好医院信息卡片
 * 米哈游毛玻璃风格 + 左侧色条
 */

import { isStale, STALE_AFTER_MONTHS, type Hospital } from '../../utils/hospitals';

interface Props {
  hospital: Hospital;
  /** 医院名标题级别：按城市平铺时为 3；zh 按「省 h2 → 市 h3」分组时为 4 */
  headingLevel?: 3 | 4;
  /**
   * 显示「待核实（超过 6 个月未复核）」标记。仅 zh 目录开启：其余语种页面的
   * 卡片文案仍是中文、结构不变，避免本次修复波及它们。
   * 构建时先判一次；页面内联脚本按访问当天日期再判一次（静态站两次构建之间也不会过时）。
   */
  showStaleMarker?: boolean;
}

const { hospital, headingLevel = 3, showStaleMarker = false } = Astro.props;
const NameTag = headingLevel === 4 ? 'h4' : 'h3';
const staleAtBuild = showStaleMarker && isStale(hospital.lastVerified);

const tierLabel: Record<string, string> = {
  tertiary: '三甲医院',
  secondary: '二甲医院',
  primary: '基层医院',
};

const isVerified = hospital.verificationLevel === 'community-verified';
const verifiedLabel = isVerified ? '社区核实' : '待核实';

// MedicalOrganization JSON-LD (schema.org) — improves local SEO discoverability.
// Map our tier vocabulary to schema.org medicalSpecialty / type hints.
const hospitalLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  '@id': `https://hrtyaku.com/zh/tools/hospital-finder/#${hospital.id}`,
  name: hospital.name,
  medicalSpecialty: 'Endocrinology',
  department: {
    '@type': 'MedicalOrganization',
    name: hospital.department,
  },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CN',
    addressRegion: hospital.province,
    addressLocality: hospital.city,
    ...(hospital.address ? { streetAddress: hospital.address } : {}),
  },
  availableService: hospital.services.map((service) => ({
    '@type': 'MedicalProcedure',
    name: service,
  })),
  audience: {
    '@type': 'MedicalAudience',
    audienceType: 'Patient',
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(hospitalLd)} />

<div
  class="hospital-card"
  id={showStaleMarker ? `hospital-${hospital.id}` : undefined}
  data-last-verified={showStaleMarker ? hospital.lastVerified : undefined}
>
  <div class="hospital-card__stripe" />
  <div class="hospital-card__body">

    <div class="hospital-card__header">
      <div class="hospital-card__title-group">
        <NameTag class="hospital-card__name">{hospital.name}</NameTag>
        <div class="hospital-card__meta">
          <span class="hospital-card__city">{hospital.city} · {hospital.province}</span>
          <span class="hospital-card__tier">{tierLabel[hospital.tier] ?? hospital.tier}</span>
        </div>
      </div>
      <span class={`hospital-card__verified ${isVerified ? 'hospital-card__verified--ok' : 'hospital-card__verified--pending'}`}>
        {verifiedLabel}
      </span>
    </div>

    <div class="hospital-card__department">
      <span class="hospital-card__label">科室</span>
      <span class="hospital-card__value">{hospital.department}</span>
    </div>

    {hospital.address && (
      <div class="hospital-card__row">
        <span class="hospital-card__label">地址</span>
        <span class="hospital-card__value hospital-card__value--muted">{hospital.address}</span>
      </div>
    )}

    <div class="hospital-card__services">
      {hospital.services.map((s) => (
        <span class="hospital-card__service-tag">{s}</span>
      ))}
    </div>

    <div class="hospital-card__info-grid">
      <div class="hospital-card__info-item">
        <p class="hospital-card__info-label">挂号方式</p>
        <p class="hospital-card__info-text">{hospital.registrationMethod}</p>
      </div>
      <div class="hospital-card__info-item">
        <p class="hospital-card__info-label">大致费用</p>
        <p class="hospital-card__info-text">{hospital.estimatedCost}</p>
      </div>
    </div>

    <div class="hospital-card__feedback">
      <p class="hospital-card__info-label">社区反馈</p>
      <p class="hospital-card__feedback-text">{hospital.communityFeedback}</p>
    </div>

    {hospital.notes && (
      <p class="hospital-card__notes">{hospital.notes}</p>
    )}

    {showStaleMarker && (
      <p class="hospital-card__stale" data-stale-marker hidden={!staleAtBuild}>
        <span class="hospital-card__stale-tag">待核实</span>
        最后核实已超过 {STALE_AFTER_MONTHS} 个月，信息可能已变化，建议出发前先向医院确认出诊与挂号方式。
      </p>
    )}

    <p class="hospital-card__updated">最后核实：<time datetime={hospital.lastVerified}>{hospital.lastVerified}</time></p>

  </div>
</div>

<style>
  .hospital-card {
    position: relative;
    display: flex;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: var(--glass-border);
    clip-path: var(--clip-corner);
    overflow: hidden;
    margin-bottom: var(--space-lg);
  }

  .hospital-card__stripe {
    width: 3px;
    flex-shrink: 0;
    background: linear-gradient(to bottom, var(--color-safe), var(--color-accent));
  }

  .hospital-card__body {
    flex: 1;
    padding: var(--space-lg);
    min-width: 0;
  }

  .hospital-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .hospital-card__title-group {
    flex: 1;
    min-width: 0;
  }

  .hospital-card__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-xs) 0;
  }

  .hospital-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .hospital-card__city {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .hospital-card__tier {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--color-accent);
    background: rgba(212, 168, 83, 0.1);
    border: 1px solid rgba(212, 168, 83, 0.2);
    padding: 1px 6px;
  }

  .hospital-card__verified {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 700;
    padding: 2px 8px;
    border: 1px solid;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .hospital-card__verified--ok {
    color: var(--color-safe);
    border-color: var(--color-safe);
  }

  /* 「待核实」是提示用户自行确认的文字信息：用 caution-text（两套皮肤都过 AA），不用浅色 accent */
  .hospital-card__verified--pending {
    color: var(--color-caution-text);
    border-color: var(--color-caution-text);
  }

  .hospital-card__stale {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    margin: 0 0 var(--space-sm) 0;
    padding: var(--space-sm) var(--space-md);
    border: 1px dashed var(--color-caution-text);
    background: var(--color-caution-alpha-10);
    color: var(--color-text-primary);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .hospital-card__stale[hidden] {
    display: none;
  }

  .hospital-card__stale-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-caution-text);
    white-space: nowrap;
  }

  /* 乐园手账：mint 做文字在白纸上对比度不足 → 字用墨色、mint 只做描边与底 */
  :global(html.sakura) .hospital-card__verified {
    border-radius: 999px;
    font-size: 0.6875rem;
    padding: 3px 10px;
    border-width: 1.5px;
  }
  :global(html.sakura) .hospital-card__verified--ok {
    color: var(--fg-1);
    border-color: var(--mint-deep);
    background: var(--color-safe-badge-bg);
  }
  :global(html.sakura) .hospital-card__verified--pending,
  :global(html.sakura) .hospital-card__stale-tag {
    color: var(--color-caution-text);
  }
  :global(html.sakura) .hospital-card__verified--pending {
    border-color: var(--color-caution-text);
    background: var(--color-caution-badge-bg);
  }
  :global(html.sakura) .hospital-card__stale {
    border-radius: var(--radius-sm);
    border: 1.5px dashed var(--color-caution-text);
    background: var(--color-caution-badge-bg);
    color: var(--fg-1);
  }

  .hospital-card__department {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .hospital-card__row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .hospital-card__label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    flex-shrink: 0;
    line-height: 1.6;
  }

  .hospital-card__value {
    font-size: 0.875rem;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .hospital-card__value--muted {
    color: var(--color-text-secondary);
    font-weight: 400;
    font-size: 0.8125rem;
  }

  .hospital-card__services {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .hospital-card__service-tag {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 700;
    padding: 3px 8px;
    background: rgba(200, 75, 124, 0.1);
    color: var(--color-primary);
    border: 1px solid rgba(200, 75, 124, 0.2);
  }

  .hospital-card__info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hospital-card__info-item {
    background: var(--color-bg-container-high);
    border: 1px solid var(--color-outline-20);
    padding: var(--space-sm) var(--space-md);
  }

  .hospital-card__info-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--color-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }

  .hospital-card__info-text {
    font-size: 0.75rem;
    color: var(--color-text-primary);
    line-height: 1.5;
  }

  .hospital-card__feedback {
    background: var(--color-bg-container);
    border: 1px solid var(--color-outline-20);
    padding: var(--space-sm) var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .hospital-card__feedback-text {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .hospital-card__notes {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-info);
    opacity: 0.7;
    margin-bottom: var(--space-xs);
  }

  .hospital-card__updated {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--color-text-muted);
    opacity: 0.5;
    text-align: right;
    margin: 0;
  }

  @media (max-width: 768px) {
    .hospital-card__info-grid {
      grid-template-columns: 1fr;
    }

    .hospital-card__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
