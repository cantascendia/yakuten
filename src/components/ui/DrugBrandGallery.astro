---
/**
 * DrugBrandGallery — 药物品牌图鉴卡片组
 * 展示某药物在各国的品牌、规格和外观信息。
 * 玻璃拟态卡片，符合「二相乐园」设计风格。
 *
 * 数据源：src/data/brand-library.json（药物图鉴 v2 分层结构，SSOT）。
 * 旧的 drug-brands.json / drug-brands.ja.json 已不再消费。
 * 类型见 src/components/interactive/brand-library/types.ts，
 * SPEC 见 docs/specs/brand-library-v2.md §6。
 *
 * 取数：brand.drugId 直接命中，或该 brand 所属 ingredient 的 drugIds 含本药物
 *      （同成分不同给药途径共用一个图版）。
 * 排序：按 market.region 的地理顺序（cn 打头，other 收尾）。
 *
 * @prop drugId - 药物 ID（对应 drugs.json / brand-library.json 的 drugId）
 * @prop title  - 板块标题（默认："品牌图鉴"）
 */
import brandLibrary from '../../data/brand-library.json';
import type { Brand, BrandLibraryData, Ingredient, L10n, MarketRegion } from '../interactive/brand-library/types';
import { t, getLocale } from '../../i18n/ui';

interface Props {
  drugId: string;
  title?: string;
}

const locale = getLocale(Astro.currentLocale, Astro.url.pathname);

// Section chrome — localized inline (component-local labels). en fallback.
const GALLERY_LABELS: Record<string, { title: string; manufacturer: string; spec: string; appearance: string }> = {
  zh: { title: '品牌图鉴', manufacturer: '厂商', spec: '规格', appearance: '外观' },
  ja: { title: 'ブランド図鑑', manufacturer: 'メーカー', spec: '規格', appearance: '外観' },
  en: { title: 'Brand Gallery', manufacturer: 'Maker', spec: 'Spec', appearance: 'Form' },
  ko: { title: '브랜드 도감', manufacturer: '제조사', spec: '규격', appearance: '외형' },
};
const L = GALLERY_LABELS[locale] ?? GALLERY_LABELS.en;
const { drugId, title = L.title } = Astro.props;
const indexPath = `/${locale}/tools/brand-index/`;

const data = brandLibrary as unknown as BrandLibraryData;
const ingredientById = new Map<string, Ingredient>(data.ingredients.map((i) => [i.id, i]));

// ── 取数：直接命中 drugId，或所属成分的 drugIds 覆盖本药物 ──
// 先取精确命中本药物（同途径）的品牌；只有该途径无任何品牌时才回退到成分级
// （避免口服页混入安瓿、注射页混入片剂）。
const exact: Brand[] = data.brands.filter((b) => b.drugId === drugId);
const matched: Brand[] = exact.length > 0
  ? exact
  : data.brands.filter((b) => ingredientById.get(b.ingredientId)?.drugIds.includes(drugId));

// ── 排序：地理顺序（近 → 远），未知 region 落到最后 ──
const REGION_ORDER: MarketRegion[] = [
  'cn', 'tw-hk', 'jp', 'kr', 'sea', 'in', 'eu', 'na', 'oceania', 'latam', 'other',
];
const regionRank = new Map<string, number>(REGION_ORDER.map((r, i) => [r, i]));
const brands = [...matched].sort(
  (a, b) =>
    (regionRank.get(a.market.region) ?? REGION_ORDER.length) -
    (regionRank.get(b.market.region) ?? REGION_ORDER.length)
);

/**
 * L10n 回退链 locale → en → zh。
 * 回退时返回实际语言 tag，模板据此打 lang 属性（SPEC §7 a11y）。
 */
function pick(value: L10n | undefined): { text: string; lang: string | undefined } {
  if (!value) return { text: '', lang: undefined };
  // L10n 是 interface（无隐式索引签名），locale 可能是 zh/en/ja/ko 之外的 13 语之一
  const direct = (value as unknown as Record<string, string | undefined>)[locale];
  if (direct) return { text: direct, lang: undefined };
  if (value.en) return { text: value.en, lang: locale === 'en' ? undefined : 'en' };
  return { text: value.zh, lang: locale === 'zh' ? undefined : 'zh' };
}

/** 规格行：strengths（· 分隔）+ 包装规格 */
function specLine(b: Brand): { text: string; lang: string | undefined } {
  const strengths = b.strengths.join(' · ');
  const pack = pick(b.pack);
  const text = [strengths, pack.text].filter(Boolean).join(' · ');
  // strengths 是 zh 写法；非 zh 页面且含汉字时标 lang="zh"
  const hasCjk = /[\u3000-\u9fff\uff00-\uffef]/.test(strengths);
  return { text, lang: strengths ? (locale !== 'zh' && hasCjk ? 'zh' : undefined) : pack.lang };
}
---

{brands.length > 0 && (
  <section class="brand-gallery" aria-label={title}>
    <h2 class="brand-gallery__title">{title}</h2>
    <div class="brand-gallery__grid">
      {brands.map((b) => {
        const manufacturer = pick(b.manufacturer.name);
        const countryName = pick(b.market.countryName);
        const appearance = pick(b.appearance.description);
        const notes = pick(b.notes);
        const spec = specLine(b);
        const photo = b.image && b.image.kind === 'photo' ? b.image : undefined;
        const photoAlt = photo ? pick(photo.alt) : undefined;
        return (
          <div class="brand-gallery__item">
            <div class="brand-card glass-card glass-card--sm glass-card--static">
              <div class="brand-card__header">
                {/* 两字母 ISO 代码标签取代 emoji 国旗：Windows Chrome 不渲染旗帜 emoji */}
                <span class="brand-card__cc">{b.market.country}</span>
                <span class="brand-card__country" lang={countryName.lang}>{countryName.text}</span>
              </div>
              <h3 class="brand-card__name">{b.name.display}</h3>
              {photo && (
                <img
                  class="brand-card__thumb"
                  src={photo.src}
                  alt={photoAlt?.text ?? b.name.display}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <dl class="brand-card__details">
                <div class="brand-card__row">
                  <dt>{L.manufacturer}</dt>
                  <dd lang={manufacturer.lang}>{manufacturer.text}</dd>
                </div>
                <div class="brand-card__row">
                  <dt>{L.spec}</dt>
                  <dd lang={spec.lang}>{spec.text}</dd>
                </div>
                <div class="brand-card__row">
                  <dt>{L.appearance}</dt>
                  <dd lang={appearance.lang}>{appearance.text}</dd>
                </div>
              </dl>
              {notes.text && (
                <p class="brand-card__notes" lang={notes.lang}>{notes.text}</p>
              )}
            </div>
          </div>
        );
      })}
    </div>
    <p class="brand-gallery__index-link">
      <a href={indexPath}>{t(locale, 'brandGallery.viewAll')}</a>
    </p>
  </section>
)}

<style>
  .brand-gallery {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid rgba(86, 65, 71, 0.2);
  }

  .brand-gallery__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-xl) 0;
  }

  .brand-gallery__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .brand-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .brand-gallery__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* --- Grid item wrapper --- */
  .brand-gallery__item {
    display: flex;
    flex-direction: column;
  }

  /* --- Brand card --- */
  .brand-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }

  .brand-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* 国家代码 monogram（取代 emoji 国旗：Windows Chrome 不渲染旗帜 emoji） */
  .brand-card__cc {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--color-text-primary);
    border: 1px solid var(--color-accent);
    border-radius: 2px;
    padding: 3px 4px;
  }

  .brand-card__country {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .brand-card__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  /* --- Photo thumbnail (仅实拍图；示意图由品牌索引页的岛屿渲染) --- */
  .brand-card__thumb {
    width: 64px;
    height: 64px;
    object-fit: contain;
    align-self: flex-start;
    background: var(--glass-bg-40, rgba(255, 255, 255, 0.06));
    border-radius: 2px;
  }

  /* --- Detail list --- */
  .brand-card__details {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .brand-card__row {
    display: flex;
    gap: var(--space-sm);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .brand-card__row dt {
    flex-shrink: 0;
    width: 2.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding-top: 1px;
  }

  .brand-card__row dd {
    margin: 0;
    color: var(--color-text-secondary);
  }

  /* --- Index link --- */
  .brand-gallery__index-link {
    margin-top: var(--space-lg);
    text-align: right;
    font-size: 0.8125rem;
  }

  .brand-gallery__index-link a {
    color: var(--color-accent);
    text-decoration: none;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    transition: opacity 0.15s;
  }

  .brand-gallery__index-link a:hover {
    opacity: 0.8;
  }

  /* --- Notes --- */
  .brand-card__notes {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: var(--space-xs) 0 0 0;
    padding-top: var(--space-xs);
    border-top: 1px solid rgba(86, 65, 71, 0.15);
  }
</style>
