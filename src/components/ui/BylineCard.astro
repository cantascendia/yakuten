---
/**
 * BylineCard — author + reviewer + last-reviewed signature block.
 *
 * E-E-A-T purpose: make authorship, medical review, and freshness visible
 * to both humans and crawlers. Pair with JSON-LD (author / reviewedBy) in
 * JsonLd.astro or BlogPostJsonLd.astro for machine readability.
 *
 * Usage (MDX or Astro):
 *   <BylineCard
 *     author="编辑部"
 *     reviewer="XX 内分泌科 医师"
 *     reviewerCredential="MD, Endocrinology"
 *     lastReviewed="2026-04-15"
 *     nextReview="2026-10-15"
 *     evidenceLevel="A"
 *     refCount={9}
 *   />
 */
interface Props {
  author?: string;
  reviewer?: string;
  reviewerCredential?: string;
  lastReviewed: string;
  nextReview?: string;
  evidenceLevel?: 'A' | 'B' | 'C' | 'X';
  refCount?: number;
  locale?: string;
}

const {
  author = 'HRT药典编辑部',
  reviewer,
  reviewerCredential,
  lastReviewed,
  nextReview,
  evidenceLevel,
  refCount,
  locale = 'zh',
} = Astro.props;

const LABELS = {
  zh: { author: '作者', reviewer: '医学复审', lastReviewed: '最后复查', nextReview: '下次复查', evidence: '证据等级', refs: '参考文献', refsSuffix: '篇' },
  en: { author: 'Author', reviewer: 'Medically reviewed', lastReviewed: 'Last reviewed', nextReview: 'Next review', evidence: 'Evidence', refs: 'References', refsSuffix: '' },
  ja: { author: '著者', reviewer: '医学監修', lastReviewed: '最終審査', nextReview: '次回審査', evidence: 'エビデンス', refs: '参考文献', refsSuffix: '件' },
  ko: { author: '저자', reviewer: '의학 검토', lastReviewed: '마지막 검토', nextReview: '다음 검토', evidence: '근거 등급', refs: '참고문헌', refsSuffix: '건' },
  pt: { author: 'Autor', reviewer: 'Revisão médica', lastReviewed: 'Última revisão', nextReview: 'Próxima revisão', evidence: 'Nível de evidência', refs: 'Referências', refsSuffix: '' },
  ru: { author: 'Автор', reviewer: 'Медицинская проверка', lastReviewed: 'Последняя проверка', nextReview: 'Следующая проверка', evidence: 'Уровень доказательности', refs: 'Источники', refsSuffix: '' },
  es: { author: 'Autor/a', reviewer: 'Revisión médica', lastReviewed: 'Última revisión', nextReview: 'Próxima revisión', evidence: 'Nivel de evidencia', refs: 'Referencias', refsSuffix: '' },
  id: { author: 'Penulis', reviewer: 'Ditinjau secara medis', lastReviewed: 'Terakhir ditinjau', nextReview: 'Tinjauan berikutnya', evidence: 'Tingkat bukti', refs: 'Referensi', refsSuffix: '' },
  th: { author: 'ผู้เขียน', reviewer: 'ตรวจทานทางการแพทย์', lastReviewed: 'ตรวจทานล่าสุด', nextReview: 'ตรวจทานครั้งถัดไป', evidence: 'ระดับหลักฐาน', refs: 'เอกสารอ้างอิง', refsSuffix: '' },
  fil: { author: 'May-akda', reviewer: 'Sinuri sa medikal', lastReviewed: 'Huling pagsusuri', nextReview: 'Susunod na pagsusuri', evidence: 'Antas ng ebidensiya', refs: 'Mga sanggunian', refsSuffix: '' },
  hi: { author: 'लेखक', reviewer: 'चिकित्सकीय समीक्षा', lastReviewed: 'अंतिम समीक्षा', nextReview: 'अगली समीक्षा', evidence: 'साक्ष्य स्तर', refs: 'संदर्भ', refsSuffix: '' },
  vi: { author: 'Tác giả', reviewer: 'Đánh giá y khoa', lastReviewed: 'Đánh giá lần cuối', nextReview: 'Đánh giá tiếp theo', evidence: 'Mức bằng chứng', refs: 'Tài liệu tham khảo', refsSuffix: '' },
  ar: { author: 'المؤلف', reviewer: 'مراجعة طبية', lastReviewed: 'آخر مراجعة', nextReview: 'المراجعة التالية', evidence: 'مستوى الأدلة', refs: 'المراجع', refsSuffix: '' },
  fa: { author: 'نویسنده', reviewer: 'بازبینی پزشکی', lastReviewed: 'آخرین بازبینی', nextReview: 'بازبینی بعدی', evidence: 'سطح شواهد', refs: 'منابع', refsSuffix: '' },
  fr: { author: 'Auteur', reviewer: 'Révision médicale', lastReviewed: 'Dernière révision', nextReview: 'Prochaine révision', evidence: 'Niveau de preuve', refs: 'Références', refsSuffix: '' },
  de: { author: 'Autor', reviewer: 'Medizinisch geprüft', lastReviewed: 'Zuletzt geprüft', nextReview: 'Nächste Prüfung', evidence: 'Evidenzgrad', refs: 'Quellen', refsSuffix: '' },
  tr: { author: 'Yazar', reviewer: 'Tıbbi inceleme', lastReviewed: 'Son inceleme', nextReview: 'Sonraki inceleme', evidence: 'Kanıt düzeyi', refs: 'Kaynaklar', refsSuffix: '' },
};
const L = (LABELS as Record<string, typeof LABELS.en>)[locale] ?? LABELS.en;
---

<aside class="byline-card" aria-label={L.reviewer}>
  <dl class="byline-card__grid">
    <div class="byline-card__row">
      <dt>{L.author}</dt>
      <dd>{author}</dd>
    </div>
    {reviewer && (
      <div class="byline-card__row">
        <dt>{L.reviewer}</dt>
        <dd>
          <span itemprop="reviewedBy">{reviewer}</span>
          {reviewerCredential && <span class="byline-card__cred"> · {reviewerCredential}</span>}
        </dd>
      </div>
    )}
    <div class="byline-card__row">
      <dt>{L.lastReviewed}</dt>
      <dd><time datetime={lastReviewed}>{lastReviewed}</time></dd>
    </div>
    {nextReview && (
      <div class="byline-card__row">
        <dt>{L.nextReview}</dt>
        <dd><time datetime={nextReview}>{nextReview}</time></dd>
      </div>
    )}
    {evidenceLevel && (
      <div class="byline-card__row">
        <dt>{L.evidence}</dt>
        <dd><span class={`byline-card__evidence byline-card__evidence--${evidenceLevel}`}>{evidenceLevel}</span></dd>
      </div>
    )}
    {typeof refCount === 'number' && refCount > 0 && (
      <div class="byline-card__row">
        <dt>{L.refs}</dt>
        <dd>{refCount}{L.refsSuffix}</dd>
      </div>
    )}
  </dl>
</aside>

<style>
  .byline-card {
    margin: var(--space-md) 0;
    padding: var(--space-sm) var(--space-md);
    background: rgba(26, 22, 37, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid var(--sl-color-gray-5, rgba(86, 65, 71, 0.25));
    border-radius: 8px;
    font-size: 0.8125rem;
    line-height: 1.5;
    clip-path: var(--clip-corner);
  }
  .byline-card__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-xs) var(--space-md);
    margin: 0;
  }
  .byline-card__row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .byline-card__row dt {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3, var(--color-text-muted, #888));
    margin: 0;
  }
  .byline-card__row dd {
    margin: 0;
    color: var(--sl-color-white, var(--color-text, #fff));
    font-family: var(--font-body);
  }
  .byline-card__cred {
    color: var(--sl-color-gray-3, var(--color-text-muted, #888));
    font-size: 0.75rem;
  }
  .byline-card__evidence {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--color-text-on-dark, #fff);
  }
  .byline-card__evidence--A { background: var(--color-safe, #3fa66a); }
  .byline-card__evidence--B { background: var(--color-info, #4a8cc1); }
  .byline-card__evidence--C { background: var(--color-caution, #d4a853); }
  .byline-card__evidence--X { background: var(--color-danger, #c84b7c); }

  @media (prefers-reduced-motion: reduce) {
    .byline-card { backdrop-filter: none; }
  }
</style>
