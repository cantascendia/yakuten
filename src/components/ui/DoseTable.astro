---
/**
 * DoseTable -- 剂量表格组件
 * 简洁表格，mono 字体显示剂量数字
 *
 * @prop headers - 表头列 (string[])
 * @prop rows - 数据行 (string[][])
 */
interface Props {
  headers: string[];
  rows: string[][];
  /** Optional accessible table name (screen-reader caption + scroll-region label). */
  caption?: string;
}

const { headers, rows, caption } = Astro.props;
---

<div class="dose-table-wrapper" data-cols={headers.length} tabindex="0" role={caption ? 'region' : undefined} aria-label={caption}>
  <table class="dose-table">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr>
        {headers.map((h) => (
          <th scope="col">{h}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, i) => (
            <td class={i === 1 ? 'dose-value' : ''} data-label={headers[i]}>
              {cell}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  /* Use body stack (Noto Sans SC first) so CJK + Latin + digits render in
     one unified typeface. Previously Space Grotesk rendered the Latin run
     (e.g. "1 mL Luer-Lock") in a sharply different tone from the adjacent
     Chinese text. Tabular-nums keeps digits aligned without needing mono. */
  .dose-table .dose-value {
    white-space: nowrap;
    font-family: var(--font-body);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .dose-table td,
  .dose-table th {
    vertical-align: top;
  }
  
  @media (max-width: 640px) {
    .dose-table .dose-value {
      font-size: 0.9375rem;
    }
  }
</style>
