---
/**
 * JSON-LD for Blog / Article pages.
 * Emits BlogPosting + Organization + WebSite + optional FAQPage.
 */
interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  tags: string[];
  url: string;
  locale: string;
  author?: string;
  faqs?: { q: string; a: string }[];
}

// NOTE: FAQPage JSON-LD is emitted by the visible <FaqSchema> in BlogPostLayout
// (Google/Bing require FAQ answers to be visible). `faqs` prop kept for back-compat
// but intentionally not rendered here to avoid a duplicate FAQPage node.
const { title, description, publishDate, updatedDate, tags, url, locale, author } = Astro.props;

const langMap: Record<string, string> = { zh: 'zh-CN', en: 'en', ja: 'ja', ko: 'ko' };
const inLanguage = langMap[locale] ?? 'zh-CN';

// Author resolution — frontmatter `author` overrides the editorial-team default.
// When the author string matches "HRT药典编辑部" / "HRT Yakuten Editorial" we keep
// it as the Organization byline (E-E-A-T signal). Other named authors render as
// a Person entity for proper Knowledge Graph attribution (named bylines surface
// in SERPs).
const EDITORIAL_BYLINES = new Set(['HRT药典编辑部', 'HRT Yakuten Editorial', 'HRT药典 编辑部', 'HRT Yakuten 編集部', 'HRT 약전 편집부']);
const isEditorial = !author || EDITORIAL_BYLINES.has(author);
const authorNode = isEditorial
  ? { "@id": "https://hrtyaku.com/#organization" }
  : { "@type": "Person", "name": author };

const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": "https://hrtyaku.com/#organization",
    "name": "HRT药典",
    "alternateName": "HRT Yakuten",
    "url": "https://hrtyaku.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://hrtyaku.com/og-image.svg",
      "width": 1200,
      "height": 630
    }
  },
  {
    "@type": "WebSite",
    "@id": "https://hrtyaku.com/#website",
    "url": "https://hrtyaku.com",
    "name": "HRT药典",
    "publisher": { "@id": "https://hrtyaku.com/#organization" }
  },
  {
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": publishDate.toISOString(),
    ...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
    "author": authorNode,
    "publisher": { "@id": "https://hrtyaku.com/#organization" },
    "mainEntityOfPage": url,
    "inLanguage": inLanguage,
    "keywords": tags,
    "about": {
      "@type": "MedicalCondition",
      "name": "Gender Dysphoria"
    },
    "isPartOf": { "@id": "https://hrtyaku.com/#website" }
  }
];

---

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph
})} />
