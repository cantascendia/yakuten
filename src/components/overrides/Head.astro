---
/**
 * Head override — extends Starlight's default Head with:
 * - Vercel Analytics & Speed Insights
 * - hreflang alternate links (HTML head, complements sitemap hreflang)
 * - x-default hreflang for language negotiation
 * - Dynamic og:type (article for /blog/, website otherwise)
 * - Bilingual og:site_name override
 * - JSON-LD structured data injected on every documentation page
 */
import Default from '@astrojs/starlight/components/Head.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import ThemeToggle from '../ThemeToggle.astro';
import SakuraHint from '../ui/SakuraHint.astro';
import JsonLd from '../seo/JsonLd.astro';

const pathname = Astro.url.pathname;
const site = 'https://hrtyaku.com';
const canonical = new URL(pathname, site).href;

// Google Analytics 4 — measurement ID G-1E6C28RJFJ.
// Active on PRODUCTION builds by default (no Vercel config needed). `PUBLIC_GA_ID`
// (Vercel env) overrides the ID anywhere; `astro dev` keeps GA OFF so local work is
// never tracked. To disable in prod without code changes, set PUBLIC_GA_ID="" .
//
// ⚠ Known limitation — mainland China blindspot:
//   gtag.js is served from googletagmanager.com, which the Great Firewall blocks /
//   throttles inconsistently. Mainland-China pageviews are therefore largely NOT
//   captured by GA. Mainland traffic is measured instead via Bing Webmaster Tools
//   and Vercel Analytics (both reachable inside China). The script is `async`, so a
//   blocked/slow gtag request never blocks rendering for mainland visitors.
//
// Privacy scope: GA collects aggregate pageview/event metrics only. We never send
// health data, user input, AI-chat content, or blood-test records to GA. No ad or
// social pixels (FB/TikTok/etc.). Honors the same `yakuten-dev` opt-out as Vercel.
const FALLBACK_GA_ID = 'G-1E6C28RJFJ';
const gaId = import.meta.env.PUBLIC_GA_ID ?? (import.meta.env.PROD ? FALLBACK_GA_ID : undefined);

// Per-page authority signals for E-E-A-T (crawler-readable meta)
const route = Astro.locals.starlightRoute;

// Override Starlight's hard-coded `og:type = "article"` so non-blog pages
// expose the correct OpenGraph type. Treat /blog/ AND core medical pages as
// articles (they are reviewed, dated, citation-bearing content); everything
// else (home, tools, about) is `website`.
// Also rewrite `og:site_name` to a locale-aware brand string.
// We mutate the existing head entries rather than appending new ones to avoid
// emitting duplicate `<meta property="og:*">` tags.
const isMedicalPage =
  pathname.includes('/medications/') ||
  pathname.includes('/risks') ||
  pathname.includes('/blood-tests') ||
  pathname.includes('/dose-limits') ||
  pathname.includes('/breast-development');
const isBlogPage = pathname.includes('/blog/');
const ogType = isBlogPage || isMedicalPage ? 'article' : 'website';

// Locale-aware site_name (preferred by Google for non-English markets).
const headLocale = pathname.startsWith('/en/')
  ? 'en'
  : pathname.startsWith('/ja/')
    ? 'ja'
    : pathname.startsWith('/ko/')
      ? 'ko'
      : 'zh';
const siteNames: Record<string, string> = {
  zh: 'HRT药典',
  en: 'HRT Yakuten',
  ja: 'HRT薬典',
  ko: 'HRT 약전',
};
const ogSiteName = siteNames[headLocale];
if (route?.head) {
  for (const tag of route.head) {
    if (tag.tag !== 'meta' || !tag.attrs) continue;
    if (tag.attrs['property'] === 'og:type') tag.attrs.content = ogType;
    if (tag.attrs['property'] === 'og:site_name') tag.attrs.content = ogSiteName;
  }
  // De-duplicate head tags that BOTH Starlight's getHead and this override emit.
  // Starlight emits a short-form og:locale (e.g. "ja") and its own canonical; we
  // emit the region-qualified og:locale ("ja_JP") and an explicit canonical below.
  // Strip Starlight's versions so every page has exactly one of each (was 2/2).
  route.head = route.head.filter(
    (tag) =>
      !(tag.tag === 'meta' && tag.attrs?.['property'] === 'og:locale') &&
      !(tag.tag === 'link' && tag.attrs?.['rel'] === 'canonical'),
  );
  // Blog posts are standalone articles, NOT 1:1 translations across locales
  // (the zh and ja blogs are different articles). Starlight's getHead emits a
  // per-locale hreflang alternate for every configured locale (17 of them) by
  // swapping the URL prefix — for /blog/ those resolve to /en/blog/…, /pt/blog/…
  // etc. that 404. Strip those auto alternates on blog pages so only the
  // canonical (self) + a self x-default below remain. Docs are untouched
  // (gated on isBlogPage), so their cross-locale hreflang is preserved.
  if (isBlogPage) {
    route.head = route.head.filter(
      (tag) => !(tag.tag === 'link' && tag.attrs?.['rel'] === 'alternate' && 'hreflang' in (tag.attrs ?? {})),
    );
  }
}
const noindex = (route?.entry?.data as Record<string, unknown> | undefined)?.noindex === true;
const entryData: Record<string, unknown> = (route?.entry?.data as Record<string, unknown>) ?? {};
const pageLastReviewed = entryData.lastReviewed
  ? new Date(entryData.lastReviewed as string | Date).toISOString()
  : null;
const pageEvidenceLevel = (entryData.evidenceLevel as string) ?? null;
const pageRefCount = Array.isArray(entryData.references) ? (entryData.references as string[]).length : 0;
const pageMedicalReviewer = (entryData.medicalReviewer as string) ?? `${siteNames[headLocale]} Editorial Team`;

// Per-page OG image URL (generated postbuild into dist/og/<locale>/<path>.png).
// Strip leading/trailing slash, drop locale segment if present (we want parts after /{locale}/).
const ogPathParts = pathname.replace(/^\//, '').replace(/\/$/, '').split('/');
const ogPageUrl = ogPathParts.length > 0
  ? `${site}/og/${ogPathParts.join('/')}.png`
  : `${site}/og-image.svg`;
// Fallback to global SVG if page isn't a content page (e.g., tool routes).
const perPageOgImage = ogPageUrl;

// Build hreflang alternates from current pathname
// Pattern: /{locale}/rest/of/path/ → extract locale, build alternates
const localeMap = [
  { code: 'zh-CN', prefix: '/zh/' },
  { code: 'en', prefix: '/en/' },
  { code: 'ja', prefix: '/ja/' },
  { code: 'ko', prefix: '/ko/' },
] as const;

// Extract the locale-independent path segment
let pagePath = '';
for (const { prefix } of localeMap) {
  if (pathname.startsWith(prefix)) {
    pagePath = pathname.slice(prefix.length);
    break;
  }
}

// x-default points to the default locale (zh) for docs. Blog posts have no
// cross-locale twin, so their x-default points at themselves (avoids a
// /zh/blog/<ja-slug>/ 404 for ja posts).
const xDefault = isBlogPage ? canonical : `${site}/zh/${pagePath}`;

// Detect current locale for og:locale
const ogLocaleMap: Record<string, string> = { '/zh/': 'zh_CN', '/en/': 'en_US', '/ja/': 'ja_JP', '/ko/': 'ko_KR' };
const currentOgLocale = Object.entries(ogLocaleMap).find(([p]) => pathname.startsWith(p))?.[1] ?? 'zh_CN';
const alternateOgLocales = Object.values(ogLocaleMap).filter((l) => l !== currentOgLocale);
---

<Default {...Astro.props}><slot /></Default>
<JsonLd />
<link rel="canonical" href={canonical} />
{/* noindex pages (e.g. paused ko locale) still pass link equity: index=no, follow=yes. */}
{noindex && <meta name="robots" content="noindex,follow" />}
<meta property="og:url" content={canonical} />
<link rel="manifest" href="/manifest.json" />
<link rel="alternate" hreflang="x-default" href={xDefault} />
<meta property="og:locale" content={currentOgLocale} />
{alternateOgLocales.map((loc) => (
  <meta property="og:locale:alternate" content={loc} />
))}
{pageLastReviewed && !isBlogPage && (
  <>
    <meta property="article:modified_time" content={pageLastReviewed} />
    <meta property="og:updated_time" content={pageLastReviewed} />
    <meta name="last-reviewed" content={pageLastReviewed.split('T')[0]} />
  </>
)}
{pageEvidenceLevel && <meta name="evidence-level" content={pageEvidenceLevel} />}
{pageRefCount > 0 && <meta name="citation-count" content={String(pageRefCount)} />}
<meta name="medical-reviewer" content={pageMedicalReviewer} />
{/* Per-page OG image override (falls back to global og-image.svg set in astro.config.mjs).
    Blog pages supply their own OG image (different path) via frontmatter.head, so this
    docs-shaped block is gated off for /blog/ to avoid emitting a wrong-path duplicate. */}
{pageLastReviewed && !isBlogPage && (
  <>
    <meta property="og:image" content={perPageOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:image" content={perPageOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </>
)}
<ThemeToggle />
{headLocale === 'zh' && <SakuraHint />}
<script is:inline>
  // Dev-mode opt-out for Vercel Analytics & Speed Insights.
  // Run `localStorage.setItem('yakuten-dev','1')` once in any browser you use
  // for testing; all subsequent pageviews/vitals from that browser are dropped.
  // Remove with `localStorage.removeItem('yakuten-dev')`.
  (function () {
    try {
      if (localStorage.getItem('yakuten-dev') === '1') {
        var drop = function () { return null; };
        window.webAnalyticsBeforeSend = drop;
        window.speedInsightsBeforeSend = drop;
      }
    } catch (_) { /* private mode etc. */ }
  })();
</script>
<Analytics />
<SpeedInsights />
{gaId && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      // Respect the same `yakuten-dev` opt-out used for Vercel analytics:
      // `localStorage.setItem('yakuten-dev','1')` flips GA's official kill switch.
      try {
        if (localStorage.getItem('yakuten-dev') === '1') {
          window['ga-disable-' + gaId] = true;
        }
      } catch (_) { /* private mode etc. */ }
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
<script>
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch(() => {});
  }
</script>
