---
import Default from '@astrojs/starlight/components/Footer.astro';
import FloatingAIChat from '../interactive/FloatingAIChat.tsx';
import BylineCard from '../ui/BylineCard.astro';
import { t, getLocale } from '../../i18n/ui';

const locale = getLocale(Astro.currentLocale, Astro.url.pathname);

// AI 助手是全屏应用页：页面自身就是完整 chat（FloatingAIChat 组件内也会 return null），
// 这里干脆不渲染岛，省一次水合与空 portal。
const isAiAppPage = Astro.url.pathname.includes('/tools/ai-assistant');

// Extract authority signals from page frontmatter (Starlight route).
const route = Astro.locals.starlightRoute;
const entry = route?.entry;
const entryData: Record<string, unknown> = (entry?.data as Record<string, unknown>) ?? {};
const lastReviewed = entryData.lastReviewed
  ? new Date(entryData.lastReviewed as string | Date).toISOString().split('T')[0]
  : null;
const evidenceLevelRaw = (entryData.evidenceLevel as string | undefined) ?? undefined;
const evidenceLevel: 'A' | 'B' | 'C' | 'X' | undefined =
  evidenceLevelRaw === 'A' || evidenceLevelRaw === 'B' || evidenceLevelRaw === 'C' || evidenceLevelRaw === 'X'
    ? evidenceLevelRaw
    : undefined;
const refCount = Array.isArray(entryData.references) ? (entryData.references as string[]).length : 0;
const medicalReviewer = (entryData.medicalReviewer as string | undefined) ?? undefined;

// Compute next review: lastReviewed + (6mo if risks/dose-limits/emergency-adjacent, else 12mo).
const pathname = Astro.url.pathname;
const isHighRisk = /\/(risks|dose-limits)(\/|$)/.test(pathname);
let nextReview: string | null = null;
if (lastReviewed) {
  const d = new Date(lastReviewed);
  d.setMonth(d.getMonth() + (isHighRisk ? 6 : 12));
  nextReview = d.toISOString().split('T')[0];
}

// Only show BylineCard on content pages that have evidence metadata.
// Blog posts carry a neutral lastReviewed (to satisfy the shared schema) but
// render their own meta line, so suppress the medical-style byline there.
const isBlogPage = pathname.includes('/blog/');
const showByline = Boolean(lastReviewed) && !isBlogPage;
// BylineCard carries labels for all 17 locales (falls back to en) — pass the
// page locale straight through. Narrowing to zh/en/ja/ko here made 13 locales
// show Chinese byline labels.
const bylineLocale = locale;
---

<Default {...Astro.props}><slot /></Default>

{showByline && lastReviewed && (
  <BylineCard
    reviewer={medicalReviewer}
    lastReviewed={lastReviewed}
    nextReview={nextReview ?? undefined}
    evidenceLevel={evidenceLevel}
    refCount={refCount}
    locale={bylineLocale}
  />
)}

<div class="site-legal-footer" data-paper="true">
  {/* sakura 专属：居中 kicker（washi 胶带 + 站点主张）。默认 display:none，
      非 sakura 可见渲染结果不变；文案复用 17 语已有的 hero.subtitle
      （zh =「循证 · 减害 · 引导就医」），不新增本地化内容。 */}
  <p class="sakura-footer-kicker">
    <span class="yk-washi" aria-hidden="true"></span>
    <span class="sakura-footer-kicker__label">{t(locale, 'hero.subtitle')}</span>
  </p>
  <p class="site-legal-footer__notice">{t(locale, 'footer.notice')}</p>
  <nav class="site-legal-footer__links" aria-label={t(locale, 'footer.navLabel')}>
    <a href={`/${locale}/about/`}>{t(locale, 'footer.link.disclaimer')}</a>
    <span aria-hidden="true">·</span>
    <a href="https://github.com/cantascendia/yakuten" target="_blank" rel="noopener noreferrer">{t(locale, 'footer.link.github')}</a>
    <span aria-hidden="true">·</span>
    {locale === 'zh' ? (
      <a href="/zh/feedback/">{t(locale, 'footer.link.feedback')}</a>
    ) : (
      <a
        href="https://github.com/cantascendia/yakuten/issues/new?template=content_correction.yml"
        target="_blank"
        rel="noopener noreferrer"
      >{t(locale, 'footer.link.feedback')}</a>
    )}
  </nav>
</div>

{/* idle + timeout 兜底：后台标签页 / 主线程繁忙时 requestIdleCallback 可被无限推迟，
    2s 后强制水合，保证 FAB 必然出现 */}
{!isAiAppPage && <FloatingAIChat client:idle={{ timeout: 2000 }} />}

<style>
  .site-legal-footer {
    max-width: 72rem;
    margin: var(--space-lg) auto 0;
    padding: var(--space-md) var(--space-lg);
    border-top: 1px solid var(--sl-color-gray-5, rgba(86, 65, 71, 0.2));
    text-align: center;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3, var(--color-text-muted, #888));
    line-height: 1.6;
  }

  .site-legal-footer__notice {
    margin: 0 0 var(--space-xs) 0;
  }

  .site-legal-footer__links {
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .site-legal-footer__links a {
    color: var(--sl-color-gray-3, var(--color-text-muted, #888));
    text-decoration: none;
    transition: color 0.15s;
  }

  .site-legal-footer__links a:hover {
    color: var(--sl-color-accent, var(--color-accent, #D4A853));
  }

  .site-legal-footer__reviewed {
    margin: var(--space-xs) 0 0 0;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    color: var(--sl-color-gray-4, var(--color-text-muted, #666));
    letter-spacing: 0.03em;
  }

  /* ======================================================================
     sakura 手账页脚 —— 以下规则全部锁 html.sakura 作用域（手工纪律）。
     未开 sakura：仅 .sakura-footer-kicker { display:none } 生效（隐藏
     sakura 专属结构），默认皮可见渲染结果不变。
     ====================================================================== */

  /* sakura 专属 kicker 结构：默认隐藏（双态常驻 SSR 机制，spec §3-②） */
  .sakura-footer-kicker {
    display: none;
  }

  /* 纸面页脚：cream 底 + 顶部 2px 墨线 + 上方腮红硬影 —— 「墨线 + 粉线」
     双线签名，与吸顶导航底线（border-bottom ink + 0 3px 0 blush）呼应。
     data-paper 属性令 --fg-* 在幻月夜仍钉回梅子墨（纸在夜里仍然亮着）。
     选择器双写 class 抬高特异度，确保稳定压过 sakura-components.css 的
     旧 .site-legal-footer 规则（bg-2 + ink-faint 边线）。 */
  :global(html.sakura) .site-legal-footer.site-legal-footer {
    background: var(--cream);
    border-top: 2px solid var(--ink);
    box-shadow: 0 -3px 0 var(--sakura-blush);
    margin-top: var(--space-2xl);
    padding: var(--space-lg);
    color: var(--fg-2);
  }

  /* kicker 排版：washi 胶带 + 退后的小标签（颜色交给胶带，文字退后）。
     不加 nowrap —— 非 CJK 语言的主张句较长，移动端必须允许折行。 */
  :global(html.sakura) .sakura-footer-kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 var(--space-sm);
    font-family: var(--font-ui-accent);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--fg-3);
    text-align: center;
  }
  /* 字距 + 大写只给非连写文字：ar/fa（阿拉伯字母连写）加 letter-spacing 会拉断
     连写形，属排版错误（红线审查 concern 修复） */
  :global(html.sakura) .sakura-footer-kicker:not(:lang(ar)):not(:lang(fa)) {
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  /* 链接：粉色正文一律 AA 替身 --sakura-pink-text；hover 换墨字 + 下划线
     （粉 deep 在 cream 上 3.2:1 不可作文字）。动效铁律：仅 transform +
     opacity —— sakura 下取消默认皮的 color 过渡。 */
  :global(html.sakura) .site-legal-footer__links a {
    color: var(--sakura-pink-text);
    transition: none;
  }
  :global(html.sakura) .site-legal-footer__links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  /* 幻月夜：页脚是 data-paper 纸面，夜里仍然亮着（cream 底不变）——
     链接钉回深粉 AA，压过 sakura-components.css 为「暗桌」场景写的
     浅粉夜规则（浅粉 on cream 1.8:1 不可读）。 */
  :global(html.sakura[data-theme='dark']) .site-legal-footer__links a {
    color: var(--sakura-pink-text);
  }
</style>
