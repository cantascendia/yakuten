---
/**
 * /zh/v2/ — 首页（HomeScreen）
 *
 * 挂在 /zh/ 下是【技术硬约束】而非偏好：Starlight 自动注入的 Astro i18n 配置
 * 里 prefixDefaultLocale=true → Astro 不生成任何根级路由，/v2/ 必然 404。
 * 详见 src/components/v2/routes.ts 顶部注释（含实测证据）。
 *
 * 薄壳：页面文件只负责挂 Layout + 屏组件。
 * 屏组件不加 client: 指令 → Astro 构建期渲染成 HTML，零 JS。
 */
import V2Layout from '../../../layouts/V2Layout.astro';
import HomeScreen from '../../../components/v2/screens/HomeScreen.tsx';
---

<V2Layout
  title="HRT药典 · Yakuten — 循证 · 减害 · 引导就医"
  description="面向中文圈跨性别女性的 HRT 安全底线信息站。基于国际临床指南与同行评审文献，为已在用药或即将用药者提供安全参考。"
  route="home"
>
  <HomeScreen />
</V2Layout>
