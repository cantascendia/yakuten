---
/**
 * BlogPostLayout — Blog/article layout rendered THROUGH Starlight.
 *
 * Wraps the bespoke article body (breadcrumbs, meta, TOC sidebar, related
 * docs/posts) in <StarlightPage template="splash"> so the post inherits the
 * full site shell for free and forever: header, footer (Footer override →
 * BylineCard + legal + FloatingAIChat), theme + 🌸 sakura (ThemeToggle),
 * GA + opt-out, service worker, fonts, JsonLd — all via the shared Head
 * override. No more standalone <html>/<head> chrome to drift out of sync.
 *
 * SEO specifics that Starlight's docs-shaped head does NOT cover are injected
 * via `frontmatter.head` (article OG + per-post OG image) and a body-slot
 * <BlogPostJsonLd> (BlogPosting + FAQPage). hreflang for /blog/ is handled by
 * the Head override (self-only — blog posts are not 1:1 translations).
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import BlogBreadcrumbs from '../components/ui/BlogBreadcrumbs.astro';
import BlogPostJsonLd from '../components/seo/BlogPostJsonLd.astro';
import RelatedDocs from '../components/ui/RelatedDocs.astro';
import { t, getLocale } from '../i18n/ui';
import { getRelatedPosts, getCategoryLabel, getBlogUrl, getBlogSlug } from '../utils/blogHelpers';
import { getReadingTime } from '../utils/readingTime';
import type { BlogEntry } from '../utils/blogHelpers';

interface Props {
  entry: BlogEntry;
  headings: { depth: number; slug: string; text: string }[];
  rawContent: string;
}

const { entry, headings, rawContent } = Astro.props;
const { title, description, publishDate, updatedDate, tags, category, locale: postLocale, relatedDocs, author, faqs } = entry.data;
const locale = getLocale(undefined, Astro.url.pathname);

const slug = getBlogSlug(entry);
const canonicalUrl = `https://hrtyaku.com${getBlogUrl(entry)}`;
const readingTime = getReadingTime(rawContent, postLocale);
const relatedPosts = await getRelatedPosts(entry.id, tags, postLocale, 3);

const dateStr = publishDate.toLocaleDateString(postLocale === 'zh' ? 'zh-CN' : postLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const updatedStr = updatedDate
  ? updatedDate.toLocaleDateString(postLocale === 'zh' ? 'zh-CN' : postLocale, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

// Per-post OG image — generated postbuild by scripts/generate-og-images.mjs
// into dist/og/blog/<locale>/<slug>.png. Injected via frontmatter.head so
// Starlight's getHead merge overrides the global og-image.svg default.
const ogImageUrl = `https://hrtyaku.com/og/blog/${postLocale}/${slug}.png`;

// Article-type OpenGraph + per-post OG image, expressed as Starlight head
// entries. og:type is already set to "article" for /blog/ paths by the Head
// override; here we add the article timestamps, tags, and the post image.
const blogHead: Array<{ tag: 'meta'; attrs: Record<string, string> }> = [
  { tag: 'meta' as const, attrs: { property: 'article:published_time', content: publishDate.toISOString() } },
  ...(updatedDate ? [{ tag: 'meta' as const, attrs: { property: 'article:modified_time', content: updatedDate.toISOString() } }] : []),
  ...tags.map((tag) => ({ tag: 'meta' as const, attrs: { property: 'article:tag', content: tag } })),
  { tag: 'meta' as const, attrs: { property: 'og:image', content: ogImageUrl } },
  { tag: 'meta' as const, attrs: { name: 'twitter:image', content: ogImageUrl } },
  { tag: 'meta' as const, attrs: { name: 'twitter:card', content: 'summary_large_image' } },
];

// TOC items (h2 and h3 only)
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<StarlightPage
  frontmatter={{
    title,
    description,
    template: 'splash',
    tableOfContents: false,
    pagefind: true,
    head: blogHead,
    // The project extends Starlight's docs schema with required medical fields;
    // <StarlightPage> validates frontmatter against that same schema, so we
    // supply neutral values. Blog is NOT reviewed medical content, so the
    // docs-shaped consumers of these fields (Footer BylineCard, Head
    // last-reviewed/OG meta, JsonLd MedicalWebPage) are gated off for /blog/.
    evidenceLevel: 'X',
    references: [],
    lastReviewed: publishDate,
  }}
  hasSidebar={false}
>
  <BlogPostJsonLd
    title={title}
    description={description}
    publishDate={publishDate}
    updatedDate={updatedDate}
    tags={tags}
    url={canonicalUrl}
    locale={postLocale}
    author={author}
    faqs={faqs}
  />

  <article class="blog-article">
    <div class="blog-article__body">
      <BlogBreadcrumbs title={title} relatedDocs={relatedDocs} />

      <div class="blog-article__meta">
        <span class="blog-article__category">{getCategoryLabel(category, locale)}</span>
        <span class="blog-article__meta-sep" aria-hidden="true">&middot;</span>
        <time class="blog-article__date" datetime={publishDate.toISOString()}>
          {t(locale, 'blog.publishedOn')} {dateStr}
        </time>
        {updatedStr && (
          <>
            <span class="blog-article__meta-sep" aria-hidden="true">&middot;</span>
            <time class="blog-article__date" datetime={updatedDate!.toISOString()}>
              {t(locale, 'blog.updatedOn')} {updatedStr}
            </time>
          </>
        )}
        <span class="blog-article__meta-sep" aria-hidden="true">&middot;</span>
        <span class="blog-article__reading-time">
          {t(locale, 'blog.readingTime').replace('{min}', String(readingTime))}
        </span>
      </div>

      <h1 class="blog-article__title">{title}</h1>

      <div class="blog-article__content">
        <slot />
      </div>

      <!-- Disclaimer -->
      <div class="blog-disclaimer">
        {t(locale, 'blog.disclaimer')}
      </div>

      <!-- Related docs (hub-and-spoke) -->
      <RelatedDocs relatedDocs={relatedDocs} />

      <!-- Related blog posts -->
      {relatedPosts.length > 0 && (
        <section class="blog-related">
          <h2 class="blog-related__title">{t(locale, 'blog.relatedArticles')}</h2>
          <div class="blog-related__list">
            {relatedPosts.map((post) => (
              <a href={getBlogUrl(post)} class="blog-related__link">
                <span class="blog-related__icon" aria-hidden="true">&#128196;</span>
                {post.data.title}
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Footer navigation -->
      <div class="blog-footer-nav">
        <a href={`/${locale}/blog/`}>{t(locale, 'blog.backToIndex')}</a>
        <a href={`/${locale}/`}>{t(locale, 'blog.backToDocs')}</a>
      </div>
    </div>

    <!-- Table of Contents (desktop sidebar) -->
    {tocItems.length > 0 && (
      <nav class="blog-toc" aria-label="Table of contents">
        <div class="blog-toc__title">Contents</div>
        <ul class="blog-toc__list">
          {tocItems.map((item) => (
            <li class="blog-toc__item">
              <a
                href={`#${item.slug}`}
                class:list={['blog-toc__link', { 'blog-toc__link--h3': item.depth === 3 }]}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</StarlightPage>
